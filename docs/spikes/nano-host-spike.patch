         throw UnsupportedOperationException("JavaScriptEngine is not available in this host")
 }
+
+// spike: Suwayomi's flareSolverrAsResponseFallback. FlareSolverr fetches the page and its body is the reply.
+private val solverClient = okhttp3.OkHttpClient.Builder().readTimeout(java.time.Duration.ofSeconds(90)).build()
+private fun solverFallback(req: okhttp3.Request): okhttp3.Response? {
+    val base = System.getenv("NANO_SOLVER") ?: return null
+    if (req.method != "GET") return null
+    val body = kotlinx.serialization.json.buildJsonObject {
+        put("cmd", kotlinx.serialization.json.JsonPrimitive("request.get"))
+        put("url", kotlinx.serialization.json.JsonPrimitive(req.url.toString()))
+        put("maxTimeout", kotlinx.serialization.json.JsonPrimitive(60000))
+    }.toString()
+    val post = okhttp3.Request.Builder().url("$base/v1").post(okhttp3.RequestBody.create("application/json".toMediaType(), body)).build()
+    val v = solverClient.newCall(post).execute().use { kotlinx.serialization.json.Json.parseToJsonElement(it.body.string()) }
+    val sol = (v as kotlinx.serialization.json.JsonObject)["solution"] as? kotlinx.serialization.json.JsonObject ?: return null
+    val html = (sol["response"] as? kotlinx.serialization.json.JsonPrimitive)?.content ?: return null
+    System.err.println("solver fallback: ${req.url} -> ${html.length} chars")
+    return okhttp3.Response.Builder().request(req).protocol(okhttp3.Protocol.HTTP_1_1).code(200).message("OK")
+        .body(okhttp3.ResponseBody.create("text/html; charset=utf-8".toMediaType(), html)).build()
+}
