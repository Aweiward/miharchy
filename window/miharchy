#!/bin/sh
# Opens the Miharchy window, or focuses it when one already runs.
# miharchy open-chapter <mangaId> <chapterId>: opens the reader on that
# chapter, in the running window or else in a new one.
# miharchy open-updates: opens Updates, the same way.
# miharchy peek: shows or hides the peek (GLOSSARY.md), the peek key's job.
# miharchy peek-next: shows the peek on the next manga in Up next, the next
# key's job.
# miharchy peek-open <mangaId> <chapterId>: shows the peek on that chapter,
# a new peek run; the popup's Up next rows.
dir="$(dirname "$(readlink -f "$0")")"

# Every Quickshell window has class org.quickshell, so the pid of this config's
# instance is what singles out the Miharchy window. The dispatch is the one
# omarchy-launch-or-focus uses.
address() {
  pid=$(quickshell list -j -p "$dir" 2>/dev/null | jq -r '.[0].pid // empty' 2>/dev/null)
  [ -n "$pid" ] || return 1
  addr=$(hyprctl clients -j 2>/dev/null | jq -r --argjson pid "$pid" 'first(.[] | select(.pid == $pid)).address // empty' 2>/dev/null)
  [ -n "$addr" ]
}

# $1 in Hyprland's Lua dispatcher syntax, else $2 in the older one.
dispatch() {
  hyprctl dispatch "$1" >/dev/null 2>&1 || hyprctl dispatch $2 >/dev/null
}

focus() {
  address || return 1
  dispatch "hl.dsp.focus({ window = \"address:$addr\" })" "focuswindow address:$addr"
}

toggle() {
  dispatch 'hl.dsp.workspace.toggle_special("miharchy")' "togglespecialworkspace miharchy"
}

# A peek is the window on the special workspace miharchy, so Hyprland holds
# the peek state. A window the user placed is resumed where it is, never
# moved; a new one starts as a peek. It shows in about 3 s or the peek fails.
# peek-next (the next key) always shows the peek, on the next manga in Up
# next; peek-open the same, on the chapter it names.
if [ "$1" = peek ] || [ "$1" = peek-next ] || [ "$1" = peek-open ]; then
  if address; then
    ws=$(hyprctl clients -j 2>/dev/null | jq -r --arg a "$addr" 'first(.[] | select(.address == $a)).workspace.name // empty' 2>/dev/null)
    if [ "$1" != peek ]; then
      if [ "$1" = peek-next ]; then
        quickshell ipc -p "$dir" call miharchy peekNext >/dev/null 2>&1
      else
        quickshell ipc -p "$dir" call miharchy peekOpen "$2" "$3" >/dev/null 2>&1
      fi
      [ "$ws" = special:miharchy ] || { focus; exit 0; }
      hyprctl monitors -j 2>/dev/null | jq -e 'any(.[]; .specialWorkspace.name == "special:miharchy")' >/dev/null 2>&1 || toggle
      exit 0
    fi
    if [ "$ws" = special:miharchy ]; then toggle; exit; fi
    quickshell ipc -p "$dir" call miharchy peek >/dev/null 2>&1
    focus
    exit 0
  fi
  # A second press while the window starts must not start another.
  # ponytail: a launcher killed mid-start leaves the marker until logout;
  # check its age if that bites.
  marker=${XDG_RUNTIME_DIR:-/tmp}/miharchy/peek-starting
  mkdir -p "${marker%/*}" && mkdir "$marker" 2>/dev/null || exit 0
  trap 'rmdir "$marker"' EXIT
  peek=1
  [ "$1" = peek-next ] && peek=next
  [ "$1" = peek-open ] && peek="$2 $3"
  MIHARCHY_PEEK=$peek setsid -f quickshell -n -p "$dir" >/dev/null 2>&1
  i=0
  until address; do
    i=$((i + 1))
    [ "$i" -le 30 ] || { echo "miharchy: the window did not start" >&2; exit 1; }
    sleep 0.1
  done
  dispatch "hl.dsp.window.move({ workspace = \"special:miharchy\", follow = false, window = \"address:$addr\" })" "movetoworkspacesilent special:miharchy,address:$addr"
  toggle
  exit 0
fi

if [ "$1" = open-chapter ]; then
  if quickshell ipc -p "$dir" call miharchy openChapter "$2" "$3" >/dev/null 2>&1; then
    focus
    exit 0
  fi
  export MIHARCHY_OPEN_CHAPTER="$2 $3"
  shift 3
elif [ "$1" = open-updates ]; then
  if quickshell ipc -p "$dir" call miharchy openUpdates >/dev/null 2>&1; then
    focus
    exit 0
  fi
  export MIHARCHY_OPEN_VIEW=updates
  shift
fi
focus && exit 0
exec quickshell -n -p "$dir" "$@"
