[Unit]
Description=Miharchy manga server (miharchy-core, ADR 0009)
After=graphical-session.target network-online.target
PartOf=graphical-session.target

[Service]
# Built by `./gradlew :server:installDist` and copied to core-app (ADR 0010); Setup takes this over in #385.
ExecStart=%h/.local/share/miharchy/core-app/bin/miharchy-core
Restart=on-failure
RestartSec=5

[Install]
WantedBy=graphical-session.target
