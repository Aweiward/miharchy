#!/usr/bin/env bash
# start-at <offset>: start the verify run's scratch miharchy-core, reusing its data, with the JVM clock
# shifted by libfaketime (offset as FAKETIME takes it: -5d, -3d, -1d). Offset 0 uses the real clock.
set -euo pipefail
[ $# = 1 ] || { echo "usage: start-at <offset>, e.g. start-at -5d or start-at 0" >&2; exit 2; }
S=$(cd "$(dirname "$0")" && pwd)/../../.claude/skills/verify-miharchy/scripts
source "$S/env.sh"
FAKETIME_LIB=${FAKETIME_LIB:-/usr/lib/faketime/libfaketime.so.1}
if [ "$1" != 0 ]; then
  [ -f "$FAKETIME_LIB" ] || { echo "no libfaketime at $FAKETIME_LIB; set FAKETIME_LIB (see README.md)" >&2; exit 1; }
  # The JVM needs a real monotonic clock and one fixed start point.
  export CORE_PRELOAD=$FAKETIME_LIB FAKETIME="$1" FAKETIME_DONT_FAKE_MONOTONIC=1 FAKETIME_DONT_RESET=1
fi
[ -f "$RUN/core/pid" ] && kill -0 "$(cat "$RUN/core/pid")" 2>/dev/null && { echo "$RUN already has a running core; run halt first" >&2; exit 1; }
"$S/core.sh" start
echo "clock offset $1"
